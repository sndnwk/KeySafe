<Window x:Class="KeySafe.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="KeySafe" Icon="{StaticResource ApplicationIcon}" Width="1450" Height="900" MinWidth="1240" MinHeight="710" WindowStartupLocation="CenterScreen" Background="{DynamicResource Bg}" Foreground="{DynamicResource TextPrimary}">
    <Grid>
        <Grid x:Name="WelcomePanel" Visibility="Visible">
            <Border Width="465" MaxWidth="465" CornerRadius="19" BorderBrush="{DynamicResource Stroke}" BorderThickness="1" Background="{DynamicResource Surface}" Padding="38" HorizontalAlignment="Center" VerticalAlignment="Center"><StackPanel>
                <TextBlock Text="Welcome to KeySafe" FontSize="30" FontWeight="Bold"/>
                <TextBlock x:Name="WelcomeSubtitle" Text="Your passwords. Your device. Your control." Foreground="{DynamicResource TextSecondary}" FontSize="14" Margin="0,9,0,29" TextWrapping="Wrap"/>
                <TextBlock x:Name="FirstPasswordLabel" Text="Master password" FontWeight="SemiBold" Margin="0,0,0,9"/>
                <PasswordBox x:Name="MasterPasswordInput" Height="48" KeyDown="MasterPasswordInput_KeyDown"/>
                <StackPanel x:Name="ConfirmationFields" Margin="0,16,0,0" Visibility="Collapsed"><TextBlock Text="Confirm master password" FontWeight="SemiBold" Margin="0,0,0,9"/><PasswordBox x:Name="ConfirmPasswordInput" Height="48" KeyDown="MasterPasswordInput_KeyDown"/><TextBlock x:Name="MasterPasswordGuidance" Text="Use a unique generated password or a long, randomly selected multiword passphrase." Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap" FontSize="12" Margin="0,12,0,0"/></StackPanel>
                <TextBlock x:Name="WelcomeError" Foreground="#FF9AA2" TextWrapping="Wrap" Margin="0,15,0,0"/>
                <Button x:Name="WelcomeAction" Content="Unlock vault" Style="{StaticResource AccentButton}" Margin="0,22,0,0" Height="48" Click="WelcomeAction_Click"/>
                <Border Height="1" Background="{DynamicResource Stroke}" Margin="0,24,0,15"/>
                <Button x:Name="RecoveryAction" Content="Use an emergency recovery key" Style="{StaticResource GhostButton}" Click="Recover_Click" Margin="0,0,0,5"/>
                <Button Content="Restore encrypted backup" Style="{StaticResource GhostButton}" Click="RestoreBackup_Click"/>
            </StackPanel></Border>
        </Grid>
        <Grid x:Name="VaultPanel" Visibility="Collapsed" Background="{DynamicResource Bg}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="305"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Background="{DynamicResource SidebarFill}" BorderBrush="{DynamicResource Stroke}" BorderThickness="0,0,1,0">
                <Grid Margin="19,22,19,20">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <StackPanel Margin="12,0,0,33">
                        <TextBlock Text="KeySafe" FontSize="23" FontWeight="Bold"/><TextBlock Text="LOCAL PASSWORD MANAGER" FontSize="10" Foreground="{DynamicResource TextSecondary}" Margin="0,3,0,0"/>
                    </StackPanel>
                    <StackPanel Grid.Row="1" Margin="0,0,0,15">
                        <TextBlock Text="YOUR VAULT" Foreground="{DynamicResource TextSecondary}" FontSize="11" FontWeight="SemiBold" Margin="12,0,0,13"/>
                        <Button x:Name="AllNav" Content="▦   All passwords" Style="{StaticResource NavButton}" Click="AllNav_Click" Height="43"/>
                        <Button x:Name="NotesNav" Content="▤   Secure notes" Style="{StaticResource NavButton}" Click="NotesNav_Click" Height="43"/>
                        <Button x:Name="FavoritesNav" Content="☆   Favorites" Style="{StaticResource NavButton}" Click="FavoritesNav_Click" Height="43"/>
                    </StackPanel>
                    <StackPanel Grid.Row="2" Margin="0,0,0,17">
                        <Border Height="1" Background="{DynamicResource Stroke}" Margin="3,3,3,15"/>
                        <TextBlock Text="QUICK ACTIONS" Foreground="{DynamicResource TextSecondary}" FontSize="11" FontWeight="SemiBold" Margin="12,0,0,12"/>
                        <Button Content="＋   Add password" Click="Add_Click" Style="{StaticResource NavButton}" Height="42"/>
                        <Button Content="＋   Add secure note" Click="AddNote_Click" Style="{StaticResource NavButton}" Height="42"/>
                    </StackPanel>
                    <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,0,0,12">
                        <StackPanel>
                            <Border Height="1" Background="{DynamicResource Stroke}" Margin="3,2,3,16"/>
                            <TextBlock Text="SECURITY &amp; TOOLS" Foreground="{DynamicResource TextSecondary}" FontSize="11" FontWeight="SemiBold" Margin="12,0,0,12"/>
                            <Expander Header="Manage vault and backups" IsExpanded="False" Margin="4,0,4,0" ToolTip="Expand for key rotation, backups and import/export">
                                <StackPanel Margin="0,9,0,0">
                                    <Button Content="Change master password" Click="ChangeMaster_Click" HorizontalContentAlignment="Left" Margin="0,0,0,6"/>
                                    <Button Content="Rotate vault and recovery keys" Click="Rotate_Click" HorizontalContentAlignment="Left" Margin="0,0,0,6"/>
                                    <Button Content="Import passwords (CSV)" Click="Import_Click" HorizontalContentAlignment="Left" Margin="0,0,0,6"/>
                                    <Button Content="Export passwords (CSV)" Click="Export_Click" HorizontalContentAlignment="Left" Margin="0,0,0,6"/>
                                    <Button Content="Create encrypted backup" Click="Backup_Click" HorizontalContentAlignment="Left" Margin="0,0,0,6"/>
                                    <CheckBox x:Name="ClipboardEnabled" Content="Allow copying secrets (30-second clear)" IsChecked="False" Margin="2,5,0,10" ToolTip="Disabled by default. Clipboard history and other programs may capture copied secrets."/>
                                    <Button Content="Restore encrypted backup" Click="RestoreBackup_Click" HorizontalContentAlignment="Left" Margin="0,0,0,6"/>
                                </StackPanel>
                            </Expander>
                        </StackPanel>
                    </ScrollViewer>
                    <StackPanel Grid.Row="4">
                        <Border Background="{DynamicResource SurfaceRaised}" CornerRadius="11" Padding="13" Margin="0,0,0,13">
                            <StackPanel>
                                <TextBlock Text="●  ENCRYPTED &amp; OFFLINE" Foreground="{DynamicResource Positive}" FontWeight="SemiBold" FontSize="11"/>
                                <TextBlock x:Name="RecoveryStatus" Text="10 of 10 recovery keys" Foreground="{DynamicResource TextSecondary}" FontSize="11" Margin="0,7,0,0"/>
                                <TextBlock x:Name="VaultPathLabel" Text="Local encrypted vault" ToolTip="Local encrypted vault location" Foreground="{DynamicResource TextSecondary}" FontSize="10" TextTrimming="CharacterEllipsis" Margin="0,5,0,0"/>
                            </StackPanel>
                        </Border>
                        <Button Content="⌑   Lock vault" Click="Lock_Click" HorizontalContentAlignment="Center" Height="43"/>
                        <TextBlock Text="KeySafe 1.1.0  ·  Dark edition" Foreground="{DynamicResource TextSecondary}" FontSize="10" HorizontalAlignment="Center" Margin="0,13,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>
            <Grid Grid.Column="1" Margin="30,24,30,19">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <DockPanel LastChildFill="True" Margin="0,0,0,21">
                    <Button Content="+ New password" DockPanel.Dock="Right" Height="43" Style="{StaticResource AccentButton}" Click="Add_Click"/>
                    <StackPanel><TextBlock x:Name="PageTitle" Text="Passwords" FontSize="29" FontWeight="Bold"/><TextBlock x:Name="ItemCount" Foreground="{DynamicResource TextSecondary}" FontSize="12" Margin="0,4,0,0"/></StackPanel>
                </DockPanel>
                <Grid Grid.Row="1" Margin="0,0,0,17">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBox x:Name="SearchInput" Height="43" TextChanged="SearchInput_TextChanged" ToolTip="Search passwords by title, username, email, website or category"/>
                    <Button Grid.Column="1" Content="+ New note" Click="AddNote_Click" Margin="12,0,0,0" Height="43"/>
                </Grid>
                <Grid Grid.Row="2" MinHeight="300">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="290"/><ColumnDefinition Width="15"/><ColumnDefinition Width="*"/><ColumnDefinition Width="18"/><ColumnDefinition Width="230"/></Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Stroke}" BorderThickness="1" CornerRadius="14" Padding="10">
                        <ListBox x:Name="CredentialsList" SelectionChanged="CredentialsList_SelectionChanged" ScrollViewer.VerticalScrollBarVisibility="Auto">
                            <ListBox.ItemTemplate><DataTemplate>
                                <Grid Margin="2"><Grid.ColumnDefinitions><ColumnDefinition Width="40"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <Border Width="36" Height="36" CornerRadius="9" Background="{DynamicResource SurfaceRaised}"><TextBlock Text="{Binding Avatar}" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold" FontSize="15"/></Border>
                                    <StackPanel Grid.Column="1" Margin="9,0,0,0"><TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Subtitle}" Foreground="{DynamicResource TextSecondary}" FontSize="11" TextTrimming="CharacterEllipsis" Margin="0,3,0,0"/><TextBlock Text="{Binding CategoryDisplay}" Foreground="{DynamicResource Primary}" FontSize="10" TextTrimming="CharacterEllipsis" Margin="0,3,0,0"/></StackPanel>
                                </Grid>
                            </DataTemplate></ListBox.ItemTemplate>
                        </ListBox>
                    </Border>
                    <Border Grid.Column="2" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Stroke}" BorderThickness="1" CornerRadius="14" Padding="24">
                        <Grid>
                            <StackPanel x:Name="EmptyDetails" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="310">
                                <TextBlock Text="Your private space" FontWeight="SemiBold" FontSize="19" HorizontalAlignment="Center"/>
                                <TextBlock Text="Select an item to see its details, or add your first password." Foreground="{DynamicResource TextSecondary}" TextAlignment="Center" TextWrapping="Wrap" Margin="0,8,0,0"/>
                            </StackPanel>
                            <ScrollViewer x:Name="DetailsPanel" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                                <StackPanel>
                                    <DockPanel LastChildFill="True"><TextBlock x:Name="FavoriteGlyph" DockPanel.Dock="Right" Text="★" FontSize="21" Foreground="#EBC17B" Margin="10,0,0,0"/><TextBlock x:Name="DetailTitle" Text="Title" FontSize="22" FontWeight="Bold" TextTrimming="CharacterEllipsis"/></DockPanel>
                                    <Border x:Name="DetailCategoryBadge" Background="{DynamicResource SurfaceRaised}" BorderBrush="{DynamicResource Stroke}" BorderThickness="1" CornerRadius="9" Padding="9,5" HorizontalAlignment="Left" Margin="0,10,0,0"><TextBlock x:Name="DetailCategory" Foreground="{DynamicResource Primary}" FontSize="11" FontWeight="SemiBold"/></Border>
                                    <StackPanel x:Name="CredentialDetails">
                                        <TextBlock Text="USERNAME" Style="{StaticResource EyebrowText}" Margin="0,22,0,8"/>
                                        <DockPanel><Button Content="Copy" DockPanel.Dock="Right" Click="CopyUsername_Click"/><TextBlock x:Name="DetailUsername" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" FontSize="14"/></DockPanel>
                                        <TextBlock Text="EMAIL" Style="{StaticResource EyebrowText}" Margin="0,20,0,8"/>
                                        <DockPanel><Button Content="Copy" DockPanel.Dock="Right" Click="CopyEmail_Click"/><TextBlock x:Name="DetailEmail" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" FontSize="14"/></DockPanel>
                                        <TextBlock Text="PASSWORD" Style="{StaticResource EyebrowText}" Margin="0,20,0,8"/>
                                        <DockPanel><Button Content="Copy" DockPanel.Dock="Right" Click="CopyPassword_Click" Margin="8,0,0,0"/><Button x:Name="RevealButton" Content="Reveal" DockPanel.Dock="Right" Click="Reveal_Click"/><TextBlock x:Name="DetailPassword" Text="••••••••••••" VerticalAlignment="Center" FontSize="14" TextTrimming="CharacterEllipsis"/></DockPanel>
                                        <TextBlock Text="WEBSITE" Style="{StaticResource EyebrowText}" Margin="0,20,0,8"/>
                                        <TextBlock x:Name="DetailWebsite" TextWrapping="Wrap"/>
                                        <StackPanel x:Name="OtpDetails" Margin="0,20,0,0" Visibility="Collapsed">
                                            <TextBlock Text="AUTHENTICATOR CODE" Style="{StaticResource EyebrowText}" Margin="0,0,0,7"/>
                                            <DockPanel><Button Content="Copy code" DockPanel.Dock="Right" Click="CopyTotp_Click"/><TextBlock x:Name="TotpCodeText" FontSize="22" FontWeight="Bold" VerticalAlignment="Center"/><TextBlock x:Name="TotpCountdownText" Foreground="{DynamicResource TextSecondary}" Margin="10,7,0,0"/></DockPanel>
                                        </StackPanel>
                                    </StackPanel>
                                    <TextBlock Text="NOTES" Style="{StaticResource EyebrowText}" Margin="0,20,0,8"/>
                                    <TextBlock x:Name="DetailNotes" TextWrapping="Wrap"/>
                                    <TextBlock Text="ENCRYPTED ATTACHMENTS" Style="{StaticResource EyebrowText}" Margin="0,20,0,8"/>
                                    <ListBox x:Name="AttachmentsList" Height="78" DisplayMemberPath="Display" SelectionMode="Single"/>
                                    <WrapPanel Margin="0,8,0,0"><Button Content="Add file" Click="AddAttachment_Click" Margin="0,0,7,7"/><Button Content="Save selected" Click="SaveAttachment_Click" Margin="0,0,7,7"/><Button Content="Remove selected" Click="RemoveAttachment_Click" Margin="0,0,7,7"/></WrapPanel>
                                    <WrapPanel Margin="0,15,0,0"><Button x:Name="EditEntryButton" Content="Edit entry" Style="{StaticResource AccentButton}" Click="Edit_Click" Margin="0,0,8,8"/><Button x:Name="HistoryButton" Content="Password history" Click="History_Click" Margin="0,0,8,8"/><Button Content="Delete" Style="{StaticResource DangerButton}" Click="Delete_Click" Margin="0,0,8,8"/></WrapPanel>
                                </StackPanel>
                            </ScrollViewer>
                        </Grid>
                    </Border>
                    <Border Grid.Column="4" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Stroke}" BorderThickness="1" CornerRadius="14" Padding="16">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <StackPanel Margin="2,0,2,14"><TextBlock Text="CATEGORIES" Style="{StaticResource EyebrowText}" Foreground="{DynamicResource Primary}"/><TextBlock Text="Organize encrypted passwords" Foreground="{DynamicResource TextSecondary}" FontSize="11" Margin="0,6,0,0" TextWrapping="Wrap"/></StackPanel>
                            <StackPanel Grid.Row="1" Margin="0,0,0,10"><Button x:Name="AllCategoriesButton" Content="All passwords" Click="AllCategories_Click" HorizontalContentAlignment="Left" Margin="0,0,0,6"/><Button x:Name="UncategorizedButton" Content="Uncategorized" Click="Uncategorized_Click" HorizontalContentAlignment="Left"/></StackPanel>
                            <ListBox Grid.Row="2" x:Name="CategoriesList" SelectionChanged="CategoriesList_SelectionChanged" ScrollViewer.VerticalScrollBarVisibility="Auto" Margin="0,0,0,12">
                                <ListBox.ItemTemplate><DataTemplate><Grid Margin="2,4"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/><Border Grid.Column="1" Background="{DynamicResource SurfaceRaised}" CornerRadius="8" Padding="7,2" Margin="8,0,0,0"><TextBlock Text="{Binding Count}" Foreground="{DynamicResource TextSecondary}" FontSize="10"/></Border></Grid></DataTemplate></ListBox.ItemTemplate>
                            </ListBox>
                            <StackPanel Grid.Row="3"><TextBlock Text="NEW CATEGORY" Style="{StaticResource EyebrowText}" Margin="2,0,0,7"/><TextBox x:Name="CategoryNameInput" Height="38" MaxLength="64" KeyDown="CategoryNameInput_KeyDown" ToolTip="1–64 visible characters"/><Grid Margin="0,7,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Button Content="Delete" Click="DeleteCategory_Click" Style="{StaticResource DangerButton}" Padding="10,6"/><Button Grid.Column="1" Content="Add" Click="AddCategory_Click" Style="{StaticResource AccentButton}" Padding="13,6"/></Grid></StackPanel>
                        </Grid>
                    </Border>
                </Grid>
                <TextBlock Grid.Row="3" x:Name="FooterStatus" Foreground="{DynamicResource TextSecondary}" FontSize="11" Text="Encrypted locally · No online account" Margin="0,13,0,0"/>
            </Grid>
        </Grid>
    </Grid>
</Window>
