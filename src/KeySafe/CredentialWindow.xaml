<Window x:Class="KeySafe.CredentialWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Entry · KeySafe" Icon="{StaticResource ApplicationIcon}" Width="790" Height="720" MinWidth="720" MinHeight="570" ResizeMode="CanResize" WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Background="{DynamicResource Bg}" Foreground="{DynamicResource TextPrimary}">
    <Border Background="{DynamicResource Bg}" Padding="24,18,24,18">
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <StackPanel Margin="0,0,0,14">
                <TextBlock Text="SECURE VAULT ENTRY" Style="{StaticResource EyebrowText}" Foreground="{DynamicResource Primary}" Margin="0,0,0,7"/>
                <TextBlock x:Name="HeaderText" Text="New password" FontSize="26" FontWeight="Bold"/>
                <TextBlock Text="All fields are encrypted locally. Changes save only when you confirm." Foreground="{DynamicResource TextSecondary}" FontSize="12" Margin="0,7,0,0"/>
            </StackPanel>
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><Grid Margin="0,0,5,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="19"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="TITLE" Style="{StaticResource EyebrowText}" Margin="0,0,0,8"/>
                    <TextBox x:Name="TitleInput" Height="42" MaxLength="2048"/>
                    <StackPanel x:Name="CredentialFields">
                        <TextBlock Text="USERNAME (OPTIONAL)" Style="{StaticResource EyebrowText}" Margin="0,15,0,7"/>
                        <TextBox x:Name="UsernameInput" Height="42" MaxLength="4096"/>
                        <TextBlock Text="EMAIL (OPTIONAL)" Style="{StaticResource EyebrowText}" Margin="0,15,0,7"/>
                        <TextBox x:Name="EmailInput" Height="42" MaxLength="4096"/>
                        <TextBlock Text="PASSWORD" Style="{StaticResource EyebrowText}" Margin="0,15,0,7"/>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <PasswordBox x:Name="PasswordInput" Height="42" PasswordChanged="PasswordInput_PasswordChanged"/>
                            <TextBox x:Name="VisiblePasswordInput" Height="42" Visibility="Collapsed" TextChanged="VisiblePasswordInput_TextChanged"/>
                            <Button Grid.Column="1" x:Name="VisibilityButton" Content="Show" Margin="7,0,0,0" Click="Visibility_Click"/>
                        </Grid>
                        <Button Content="Generate secure password" Click="Generate_Click" HorizontalAlignment="Left" Margin="0,7,0,0"/>
                        <TextBlock x:Name="GeneratorInfo" Foreground="{DynamicResource TextSecondary}" FontSize="11" Margin="0,7,0,0"/>
                        <TextBlock Text="WEBSITE" Style="{StaticResource EyebrowText}" Margin="0,15,0,7"/>
                        <TextBox x:Name="WebsiteInput" Height="42" MaxLength="4096"/>
                        <TextBlock Text="AUTHENTICATOR (OPTIONAL)" Style="{StaticResource EyebrowText}" Margin="0,15,0,7"/>
                        <TextBox x:Name="TotpInput" Height="42" MaxLength="2048" ToolTip="Paste a Base32 secret or otpauth://totp URI"/>
                        <TextBlock Text="Base32 secret or otpauth:// URI" Foreground="{DynamicResource TextSecondary}" FontSize="11" Margin="0,7,0,0"/>
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <StackPanel x:Name="CategoryFields">
                        <TextBlock Text="CATEGORY" Style="{StaticResource EyebrowText}" Margin="0,0,0,8"/>
                        <ComboBox x:Name="CategoryInput" Height="42" ToolTip="Organize this password in an encrypted vault category"/>
                    </StackPanel>
                    <TextBlock Text="PRIVATE NOTES" Style="{StaticResource EyebrowText}" Margin="0,15,0,8"/>
                    <TextBox x:Name="NotesInput" AcceptsReturn="True" TextWrapping="Wrap" Height="220" VerticalContentAlignment="Top" MaxLength="524288" VerticalScrollBarVisibility="Auto"/>
                    <CheckBox x:Name="FavoriteInput" Content="Add to favorites" Margin="2,11,0,0"/>
                    <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Stroke}" BorderThickness="1" CornerRadius="10" Padding="13" Margin="0,12,0,0">
                        <StackPanel><TextBlock Text="PRIVATE BY DESIGN" Foreground="{DynamicResource Positive}" FontWeight="SemiBold" FontSize="11"/><TextBlock Text="Passwords, notes and authenticator secrets remain in your encrypted local vault." Foreground="{DynamicResource TextSecondary}" FontSize="12" TextWrapping="Wrap" Margin="0,7,0,0"/></StackPanel>
                    </Border>
                </StackPanel>
            </Grid></ScrollViewer>
            <Grid Grid.Row="2" Margin="0,12,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock x:Name="ErrorText" Foreground="#FF929E" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,12,0"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal"><Button Content="Cancel" Click="Cancel_Click" Margin="0,0,9,0"/><Button Content="Save entry" Style="{StaticResource AccentButton}" Click="Save_Click"/></StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
